        "LogicalResourceId/TheseusBucket",
        "LogicalResourceId/DurabilityTable",
        "LogicalResourceId/OwnerRole",
        "LogicalResourceId/DeployerRole",
        "LogicalResourceId/GuardIacPolicy",
        "LogicalResourceId/GuardLimitsPolicy",
        "LogicalResourceId/BoundaryPolicy",
        "LogicalResourceId/DenySpendPolicy",
        "LogicalResourceId/MonthlyBudget",
        "LogicalResourceId/BudgetStopAction"
      ]
    }
  ]
}
