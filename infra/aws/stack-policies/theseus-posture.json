{
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "Update:*",
      "Principal": "*",
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": ["Update:Replace", "Update:Delete"],
      "Principal": "*",
      "Resource": [
        "LogicalResourceId/Trail",
        "LogicalResourceId/TrailBucket",
        "LogicalResourceId/TrailBucketPolicy",
        "LogicalResourceId/TrailKey",
        "LogicalResourceId/TrailLogGroup"
      ]
    }
  ]
}
