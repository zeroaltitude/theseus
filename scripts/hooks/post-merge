#!/usr/bin/env bash
# theseus-stats-landing: STATS.md is counted again at every landing on `main` (issue 45), with no one remembering.
#
# Installed by `scripts/stats-hook.sh install` into the repository's shared hooks directory, as `post-merge` (a
# `git merge` that commits) and as `post-commit` (the `git commit` after a `git merge --no-commit`). It acts only on
# a MERGE made on the branch `main`: HEAD is `refs/heads/main` and HEAD has two parents. Then it runs
# scripts/stats.py on the merge's tree and, when STATS.md changed, folds it into that merge (a new commit with the
# same parents, so STATS.md's "Counted at the merge of B into A" stays true of the commit that carries it). Any other commit, on any other branch, a fast-forward, or a detached HEAD, is left alone: so branches never
# touch STATS.md, and no two branches conflict on it.
#
# Why after the merge and not before it: git runs `pre-merge-commit` before it writes MERGE_HEAD and after it has
# written the merge's tree, so a file staged there names no merged commit and is not in the merge.
#
# The build sizes: when the main tree's optimised build (`$CARGO_TARGET_DIR` or `target`, profile `release`) has a
# build stamp, they are read from it again, under the commit that stamp names; else the sizes already in STATS.md are
# kept as they were.
#
# Not covered, by design:
#   - the self loop's join, which merges in a detached tree (rsi/join/git.rs): HEAD is not `main` there, and how the
#     loop counts is a separate change, reviewed before it lands;
#   - a fast-forward landing (there is no merge to fold into), and a landing made by pushing a merge made in another
#     clone (the count happens where the merge is made).
#
# The fold signs when `commit.gpgsign` is on, as a commit would. A count or a fold that fails never undoes the landing: it says
# so, and the merge stays as it was.
set -u
[ "$(git symbolic-ref -q HEAD)" = refs/heads/main ] || exit 0
[ "$(git rev-list --parents -n 1 HEAD | wc -w)" -eq 3 ] || exit 0
root=$(git rev-parse --show-toplevel) || exit 0
[ -f "$root/scripts/stats.py" ] || exit 0
prof="${CARGO_TARGET_DIR:-$root/target}/release"
sizes=()
[ -f "$prof/.theseus-build-stamp" ] && sizes=(--sizes-from "$prof")
if ! python3 -I "$root/scripts/stats.py" --root "$root" "${sizes[@]}"; then
  echo "stats: the count failed; the merge stays as it was" >&2
  exit 0
fi
if git -C "$root" ls-files --error-unmatch STATS.md >/dev/null 2>&1 && git -C "$root" diff --quiet -- STATS.md; then
  exit 0
fi
# Fold it in with plumbing, not `commit --amend`: git still holds MERGE_HEAD while post-merge runs, and refuses an amend
# then. The new commit has the merge's parents, message, author and committer, and its tree plus STATS.md; `main` is
# moved to it only if it still points at the merge (a compare-and-swap), and the index is brought along.
fold() {
  local head tree idx blob sign=() parents=() new p
  head=$(git -C "$root" rev-parse HEAD) || return 1
  idx=$(mktemp) || return 1
  blob=$(git -C "$root" hash-object -w -- "$root/STATS.md") &&
    GIT_INDEX_FILE=$idx git -C "$root" read-tree "$head" &&
    GIT_INDEX_FILE=$idx git -C "$root" update-index --add --cacheinfo "100644,$blob,STATS.md" &&
    tree=$(GIT_INDEX_FILE=$idx git -C "$root" write-tree)
  local ok=$?
  rm -f "$idx"
  [ "$ok" = 0 ] || return 1
  [ "$(git -C "$root" config --type=bool --get commit.gpgsign || echo false)" = true ] && sign=(-S)
  for p in $(git -C "$root" rev-list --parents -n 1 "$head" | cut -d' ' -f2-); do parents+=(-p "$p"); done
  new=$(git -C "$root" log -1 --format=%B "$head" |
    GIT_AUTHOR_NAME="$(git -C "$root" log -1 --format=%an "$head")" \
    GIT_AUTHOR_EMAIL="$(git -C "$root" log -1 --format=%ae "$head")" \
    GIT_AUTHOR_DATE="$(git -C "$root" log -1 --format=%ad --date=raw "$head")" \
    GIT_COMMITTER_NAME="$(git -C "$root" log -1 --format=%cn "$head")" \
    GIT_COMMITTER_EMAIL="$(git -C "$root" log -1 --format=%ce "$head")" \
    GIT_COMMITTER_DATE="$(git -C "$root" log -1 --format=%cd --date=raw "$head")" \
    git -C "$root" commit-tree "${sign[@]}" "${parents[@]}" "$tree") &&
    git -C "$root" update-ref -m "stats: count folded into the merge" refs/heads/main "$new" "$head" &&
    git -C "$root" add -- STATS.md
}
fold || echo "stats: STATS.md was counted but not folded into the merge; commit it by hand" >&2
exit 0
