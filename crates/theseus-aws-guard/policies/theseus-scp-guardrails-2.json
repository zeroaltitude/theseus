{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployerRole",
      "Effect": "Deny",
      "Action": [
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::*:role/theseus-cfn-deployer",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/theseus-cfn-deployer"
        }
      }
    },
    {
      "Sid": "DeployerPass",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/theseus-cfn-deployer",
      "Condition": {
        "StringNotEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "HandBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::*:role/theseus-hand-*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/theseus-cfn-deployer"
        }
      }
    },
    {
      "Sid": "NetworkNotOurs",
      "Effect": "Deny",
      "Action": [
        "ec2:Delete*",
        "ec2:Disassociate*",
        "ec2:Detach*",
        "ec2:Replace*",
        "ec2:Modify*",
        "ec2:Associate*",
        "ec2:Attach*",
        "ec2:Authorize*",
        "ec2:Revoke*",
        "ec2:CreateRoute",
        "ec2:CreateNetworkAclEntry",
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:vpc*",
        "arn:aws:ec2:*:*:subnet/*",
        "arn:aws:ec2:*:*:route-table/*",
        "arn:aws:ec2:*:*:natgateway/*",
        "arn:aws:ec2:*:*:internet-gateway/*",
        "arn:aws:ec2:*:*:network-acl/*",
        "arn:aws:ec2:*:*:security-group/*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/theseus:owner": "true",
          "ec2:CreateAction": "true"
        }
      }
    }
  ]
}
