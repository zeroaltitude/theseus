{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAll",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "Guards",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Create*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Put*",
        "iam:Remove*",
        "iam:Set*",
        "iam:Update*",
        "iam:Upload*",
        "ec2:CreateVpc*",
        "ec2:ModifyVpc*",
        "ec2:CreateRoute*",
        "ec2:ReplaceRoute*",
        "ec2:CreateNetworkAcl*",
        "ec2:ReplaceNetworkAcl*",
        "ec2:AuthorizeSecurityGroup*",
        "ec2:RevokeSecurityGroup*",
        "ec2:CreateTransitGateway*",
        "ec2:CreateVpn*",
        "ec2:CreateLaunchTemplate*",
        "ec2:Associate*",
        "elasticloadbalancing:Create*",
        "elasticloadbalancing:Modify*",
        "elasticloadbalancing:Set*",
        "rds:Create*",
        "rds:Restore*",
        "rds:ModifyDB*SnapshotAttribute",
        "lambda:Create*",
        "lambda:Update*",
        "lambda:Add*",
        "elasticfilesystem:Create*",
        "elasticfilesystem:Put*",
        "logs:Put*Policy",
        "logs:Put*Filter",
        "logs:PutDestination*",
        "ecs:Create*",
        "ecs:UpdateCluster*",
        "application-autoscaling:Put*",
        "batch:Create*",
        "batch:Update*",
        "es:Create*",
        "es:Update*",
        "account:Put*",
        "codebuild:UpdateProject*",
        "scheduler:Create*",
        "autoscaling:Create*",
        "eks:Create*",
        "access-analyzer:Create*",
        "access-analyzer:Update*",
        "guardduty:Create*",
        "guardduty:Update*",
        "ec2:Create*Gateway",
        "ec2:Attach*Gateway",
        "ec2:Modify*Attribute",
        "s3:PutBucket*",
        "s3:Put*Configuration",
        "cloudformation:Create*",
        "cloudformation:Update*",
        "cloudformation:Delete*",
        "ec2:ModifySecurityGroupRules",
        "ec2:AllocateAddress",
        "cloudfront:CreateDistribution",
        "cloudfront:CopyDistribution",
        "s3:PutAccountPublicAccessBlock",
        "ram:CreateResourceShare",
        "ram:AssociateResourceShare",
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "cloudtrail:PutEventSelectors",
        "guardduty:DeleteDetector",
        "guardduty:ArchiveFindings",
        "config:StopConfigurationRecorder",
        "config:DeleteConfigurationRecorder",
        "config:DeleteDeliveryChannel",
        "access-analyzer:DeleteAnalyzer",
        "securityhub:DisableSecurityHub",
        "ec2:DisableEbsEncryptionByDefault",
        "ec2:CreateKeyPair",
        "ec2:ImportKeyPair",
        "budgets:ModifyBudget",
        "budgets:CreateBudgetAction",
        "budgets:UpdateBudgetAction",
        "budgets:DeleteBudgetAction",
        "budgets:ExecuteBudgetAction",
        "organizations:CreateOrganization",
        "organizations:AcceptHandshake",
        "organizations:LeaveOrganization",
        "account:DeleteAlternateContact",
        "ec2:CreateSubnet",
        "ec2:CreateSecurityGroup",
        "ec2:AcceptVpcPeeringConnection",
        "ec2:CreateFlowLogs",
        "ec2:RunInstances",
        "ec2:ModifyLaunchTemplate",
        "ec2:CreateVolume",
        "ec2:CreatePlacementGroup",
        "s3:CreateBucket",
        "s3:DeleteBucketPolicy",
        "dynamodb:CreateTable",
        "dynamodb:UpdateTable",
        "dynamodb:CreateGlobalTable",
        "dynamodb:UpdateGlobalTable",
        "dynamodb:UpdateTimeToLive",
        "elasticfilesystem:UpdateFileSystem",
        "backup:PutBackupVaultAccessPolicy",
        "glacier:SetVaultAccessPolicy",
        "sqs:CreateQueue",
        "sqs:SetQueueAttributes",
        "sqs:AddPermission",
        "sns:CreateTopic",
        "sns:SetTopicAttributes",
        "sns:AddPermission",
        "kinesis:CreateStream",
        "firehose:CreateDeliveryStream",
        "logs:CreateLogGroup",
        "logs:DeleteRetentionPolicy",
        "logs:AssociateKmsKey",
        "logs:DisassociateKmsKey",
        "ecs:PutClusterCapacityProviders",
        "states:CreateStateMachine",
        "states:UpdateStateMachine",
        "codebuild:CreateProject",
        "sagemaker:CreateEndpoint",
        "sagemaker:CreateNotebookInstance",
        "ecr:CreateRepository",
        "ecr:SetRepositoryPolicy",
        "ecr:PutRegistryPolicy",
        "ecr:PutLifecyclePolicy",
        "elasticache:CreateCacheCluster",
        "elasticache:CreateReplicationGroup",
        "redshift:CreateCluster",
        "redshift:RestoreFromClusterSnapshot",
        "mq:CreateBroker",
        "dms:CreateReplicationInstance",
        "kms:CreateKey",
        "kms:PutKeyPolicy",
        "kms:CreateAlias",
        "kms:UpdateAlias",
        "kms:EnableKeyRotation",
        "kms:DisableKeyRotation",
        "secretsmanager:PutResourcePolicy",
        "acm:RequestCertificate",
        "acm:ImportCertificate",
        "cloudfront:UpdateDistribution",
        "route53:CreateHostedZone",
        "route53:ChangeResourceRecordSets",
        "route53:AssociateVPCWithHostedZone",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:PutCompositeAlarm",
        "events:PutRule",
        "events:PutTargets",
        "events:CreateEventBus",
        "events:PutPermission",
        "scheduler:UpdateSchedule",
        "application-autoscaling:RegisterScalableTarget",
        "cloudtrail:CreateTrail",
        "config:PutConfigurationRecorder",
        "config:PutDeliveryChannel",
        "config:PutConfigRule",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:ContinueUpdateRollback",
        "cloudformation:RollbackStack",
        "cloudformation:CancelUpdateStack",
        "cloudformation:SetStackPolicy",
        "cloudformation:ImportStacksToStackSet"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KmsGrantDirect",
      "Effect": "Deny",
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "false"
        }
      }
    },
    {
      "Sid": "TrailStorage",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::theseus-trail-*"
    },
    {
      "Sid": "TrailKey",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringLike": {
          "kms:ResourceAliases": "alias/theseus-trail*"
        }
      }
    },
    {
      "Sid": "AlertTamper",
      "Effect": "Deny",
      "Action": [
        "events:DeleteRule",
        "events:DisableRule",
        "events:RemoveTargets",
        "sns:DeleteTopic",
        "sns:Unsubscribe"
      ],
      "Resource": [
        "arn:aws:events:*:*:rule/theseus-posture-*",
        "arn:aws:sns:*:*:theseus-alerts"
      ]
    },
    {
      "Sid": "APIGatewaySVerbs",
      "Effect": "Deny",
      "Action": [
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH"
      ],
      "Resource": [
        "arn:aws:apigateway:*::/restapis",
        "arn:aws:apigateway:*::/restapis/*",
        "arn:aws:apigateway:*::/apis",
        "arn:aws:apigateway:*::/apis/*",
        "arn:aws:apigateway:*::/domainnames",
        "arn:aws:apigateway:*::/domainnames/*"
      ]
    },
    {
      "Sid": "PassTheDeployer",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/theseus-cfn-deployer"
    }
  ]
}
