{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAll",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "Guards",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Create*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Put*",
        "iam:Remove*",
        "iam:Set*",
        "iam:Update*",
        "iam:Upload*",
        "ec2:CreateVpc*",
        "ec2:ModifyVpc*",
        "ec2:CreateRoute*",
        "ec2:ReplaceRoute*",
        "ec2:CreateNetworkAcl*",
        "ec2:ReplaceNetworkAcl*",
        "ec2:AuthorizeSecurityGroup*",
        "ec2:RevokeSecurityGroup*",
        "ec2:CreateTransitGateway*",
        "ec2:CreateVpn*",
        "ec2:CreateLaunchTemplate*",
        "ec2:Associate*",
        "elasticloadbalancing:Create*",
        "elasticloadbalancing:Modify*",
        "elasticloadbalancing:Set*",
        "rds:Create*",
        "rds:Restore*",
        "rds:ModifyDB*SnapshotAttribute",
        "lambda:Create*",
        "lambda:Update*",
        "lambda:Add*",
        "elasticfilesystem:Create*",
        "elasticfilesystem:Put*",
        "logs:Put*Policy",
        "logs:Put*Filter",
        "logs:PutDestination*",
        "ecs:Create*",
        "ecs:UpdateCluster*",
        "application-autoscaling:Put*",
        "batch:Create*",
        "batch:Update*",
        "es:Create*",
        "es:Update*",
        "account:Put*",
        "codebuild:UpdateProject*",
        "scheduler:Create*",
        "autoscaling:Create*",
        "eks:Create*",
        "access-analyzer:Create*",
        "access-analyzer:Update*",
        "guardduty:Create*",
        "guardduty:Update*",
        "ec2:Create*Gateway",
        "ec2:Attach*Gateway",
        "ec2:Modify*Attribute",
        "s3:PutBucket*",
        "s3:Put*Configuration",
        "cloudformation:Create*",
        "cloudformation:Update*",
        "cloudformation:Delete*",
        "cloudtrail:Create*",
        "cloudtrail:Delete*",
        "cloudtrail:Put*",
        "cloudtrail:Stop*",
        "cloudtrail:Update*",
        "config:Delete*",
        "config:PutConfig*",
        "config:PutDelivery*",
        "config:Stop*",
        "guardduty:Delete*",
        "securityhub:Disable*",
        "access-analyzer:Delete*",
        "account:Delete*",
        "organizations:Accept*",
        "organizations:Create*",
        "organizations:Leave*",
        "budgets:Create*",
        "budgets:Delete*",
        "budgets:Execute*",
        "budgets:Modify*",
        "budgets:Update*",
        "cloudwatch:Put*Alarm",
        "logs:Associate*",
        "logs:Delete*",
        "logs:Disassociate*",
        "kms:Disable*Rotation",
        "kms:Enable*",
        "kms:Put*",
        "kms:Update*",
        "acm:Import*",
        "acm:Request*",
        "s3:PutAccount*",
        "secretsmanager:Put*Policy",
        "glacier:Set*",
        "backup:Put*",
        "ec2:Accept*",
        "ec2:Allocate*",
        "ec2:Create*Group",
        "ec2:Disable*",
        "ec2:Import*",
        "route53:Associate*",
        "route53:Change*RecordSets",
        "route53:Create*",
        "ram:Associate*",
        "ram:Create*",
        "cloudfront:Copy*",
        "cloudfront:Update*",
        "elasticache:Create*",
        "redshift:CreateCluster*",
        "redshift:Restore*",
        "dms:Create*",
        "mq:CreateBroker*",
        "dynamodb:Create*",
        "dynamodb:Update*Table*",
        "dynamodb:UpdateTime*",
        "elasticfilesystem:Update*",
        "ecr:Create*",
        "ecr:Put*Policy",
        "ecr:Set*",
        "ecs:PutCluster*",
        "s3:Delete*Policy",
        "events:Create*",
        "kinesis:Create*",
        "firehose:Create*",
        "states:Create*",
        "states:Update*",
        "sns:Add*",
        "sns:Create*",
        "sns:Set*",
        "sqs:Add*",
        "sqs:Create*",
        "sqs:Set*",
        "codebuild:Create*",
        "scheduler:Update*",
        "application-autoscaling:Register*",
        "cloudformation:Execute*",
        "cloudformation:Import*",
        "cloudformation:Set*",
        "ec2:ModifySecurityGroupRules",
        "cloudfront:CreateDistribution",
        "guardduty:ArchiveFindings",
        "ec2:CreateKeyPair",
        "ec2:CreateSubnet",
        "ec2:CreateFlowLogs",
        "ec2:RunInstances",
        "ec2:ModifyLaunchTemplate",
        "ec2:CreateVolume",
        "s3:CreateBucket",
        "logs:CreateLogGroup",
        "sagemaker:CreateEndpoint",
        "sagemaker:CreateNotebookInstance",
        "kms:CreateKey",
        "kms:CreateAlias",
        "events:PutRule",
        "events:PutTargets",
        "events:PutPermission",
        "cloudformation:ContinueUpdateRollback",
        "cloudformation:RollbackStack",
        "cloudformation:CancelUpdateStack"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KmsGrantDirect",
      "Effect": "Deny",
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "false"
        }
      }
    },
    {
      "Sid": "TrailStorage",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::theseus-trail-*"
    },
    {
      "Sid": "TrailKey",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringLike": {
          "kms:ResourceAliases": "alias/theseus-trail*"
        }
      }
    },
    {
      "Sid": "AlertTamper",
      "Effect": "Deny",
      "Action": [
        "events:DeleteRule",
        "events:DisableRule",
        "events:RemoveTargets",
        "sns:DeleteTopic",
        "sns:Unsubscribe"
      ],
      "Resource": [
        "arn:aws:events:*:*:rule/theseus-posture-*",
        "arn:aws:sns:*:*:theseus-alerts"
      ]
    },
    {
      "Sid": "NetworkNotOurs",
      "Effect": "Deny",
      "Action": [
        "ec2:Delete*",
        "ec2:Disassociate*",
        "ec2:Detach*",
        "ec2:Replace*",
        "ec2:Modify*",
        "ec2:Attach*",
        "ec2:Authorize*",
        "ec2:Revoke*",
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:vpc*",
        "arn:aws:ec2:*:*:subnet/*",
        "arn:aws:ec2:*:*:route-table/*",
        "arn:aws:ec2:*:*:natgateway/*",
        "arn:aws:ec2:*:*:internet-gateway/*",
        "arn:aws:ec2:*:*:network-acl/*",
        "arn:aws:ec2:*:*:security-group/*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/theseus:owner": "true",
          "ec2:CreateAction": "true"
        }
      }
    },
    {
      "Sid": "APIGatewaySVerbs",
      "Effect": "Deny",
      "Action": [
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH"
      ],
      "Resource": [
        "arn:aws:apigateway:*::/restapis",
        "arn:aws:apigateway:*::/restapis/*",
        "arn:aws:apigateway:*::/apis",
        "arn:aws:apigateway:*::/apis/*",
        "arn:aws:apigateway:*::/domainnames",
        "arn:aws:apigateway:*::/domainnames/*"
      ]
    },
    {
      "Sid": "PassTheDeployer",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/theseus-cfn-deployer"
    }
  ]
}
